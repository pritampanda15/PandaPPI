# PyMOL script for visualizing protein interactions
# Generated by PandaPPI

load antigen_antibody.pdb, protein
hide everything
show cartoon
color gray80, protein
set cartoon_transparency, 0.5

group Interactions
group hydrogenbonds, hydrogenbonds_*
distance hydrogenbonds_001, (chain L and resi 34 and name ND2), (chain H and resi 108 and name O)
color blue, hydrogenbonds_001
show sticks, (chain L and resi 34 and name ND2) or (chain H and resi 108 and name O)
