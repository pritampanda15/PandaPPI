# VMD script for visualizing protein interactions
# Generated by PandaPPI

mol new antigen_antibody.pdb
mol delrep 0 top
mol representation NewCartoon
mol color ColorID 8
mol selection "all"
mol material Transparent
mol addrep top

# Create a graphics object for labels
draw color black
draw materials off
# Hydrogen Bonds
draw color 0.0 0.0 1.0
draw text {30 2.0 0} "Hydrogen Bonds"
# Show residues involved in interaction 1
mol representation Licorice 0.3 12.0 12.0
mol color Element
mol selection "(chain L and resid 34 and name ND2) or (chain H and resid 108 and name O)"
mol material Opaque
mol addrep top
set sel1 [atomselect top "chain L and resid 34 and name ND2"]
set sel2 [atomselect top "chain H and resid 108 and name O"]
set coord1 [lindex [$sel1 get {ND2}] 0]
set coord2 [lindex [$sel2 get {O}] 0]
draw color 0.0 0.0 1.0
draw line $coord1 $coord2 style dashed width 3
$sel1 delete
$sel2 delete

